{
  "name": "PaxxTouch Remote",
  "version": "0.2.3",
  "description": "U1 remote screen mirror for BTT K-Touch / PandaTouch — WiFi + printer setup, fullscreen panel mirror with touch",
  "chip": "ESP32-S3",
  "hardware": "BTT K-Touch / PandaTouch (ESP32-S3, 16 MB flash, 8 MB PSRAM)",
  "github": {
    "owner": "TechJeeper",
    "repo": "PaxxTouch"
  },
  "flash": {
    "mode": "keep",
    "freq": "keep",
    "size": "keep",
    "compress": false,
    "eraseAll": true
  },
  "baudRate": 115200,
  "firmwareLocal": {
    "base": "./firmware/"
  },
  "firmwareCdn": {
    "owner": "TechJeeper",
    "repo": "PaxxTouch",
    "ref": "main",
    "path": "docs/flasher/firmware/"
  },
  "files": [
    { "asset": "paxxtouch-bootloader.bin", "offset": 0 },
    { "asset": "paxxtouch-partitions.bin", "offset": 32768 },
    { "asset": "paxxtouch-boot_app0.bin", "offset": 57344, "optional": true },
    { "asset": "paxxtouch-firmware.bin", "offset": 65536 }
  ],
  "localFallback": {
    "bootloader.bin": 0,
    "partitions.bin": 32768,
    "boot_app0.bin": 57344,
    "firmware.bin": 65536
  },
  "usbFilters": [
    { "usbVendorId": 6790 },
    { "usbVendorId": 12346 },
    { "usbVendorId": 4292 },
    { "usbVendorId": 1027 },
    { "usbVendorId": 1659 }
  ]
}
